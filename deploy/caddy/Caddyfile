# Ingress for the Gantry stack. The container listens on 8443 (HTTPS) and 8080 (HTTP, ACME challenges only); compose
# publishes 8443 as 127.0.0.1:443 locally and as :443 in the production profile.
#   GANTRY_HOSTNAME  the site's name (default localhost)
#   GANTRY_TLS       `internal` (default): a certificate from Caddy's local CA (root at
#                    /data/caddy/pki/authorities/local/root.crt in the caddydata volume; see deploy/README.md);
#                    an email address: a public certificate from Let's Encrypt (ACME), renewed automatically;
#                    `/certs/tls.crt /certs/tls.key`: your own certificate, mounted at /certs (deploy/PRODUCTION.md).
{
	admin off
	http_port 8080
	https_port 8443
	auto_https disable_redirects
	default_sni {$GANTRY_HOSTNAME:localhost}
	skip_install_trust
	servers {
		protocols h1 h2
	}
}

https://{$GANTRY_HOSTNAME:localhost} {
	tls {$GANTRY_TLS:internal}

	log {
		output stdout
		# Invite tokens, OIDC codes and id_token_hint travel in query strings, and the CSRF token in a header: none of them belong in a log.
		# Caddy redacts Authorization and Cookie by default; the rest are replaced here.
		format filter {
			wrap json
			fields {
				request>uri query {
					replace invite REDACTED
					replace code REDACTED
					replace state REDACTED
					replace session_state REDACTED
					replace id_token_hint REDACTED
					replace login_hint REDACTED
					replace token REDACTED
				}
				request>headers>X-Csrf-Token replace REDACTED
				request>headers>X-Api-Key replace REDACTED
			}
		}
	}

	# Headers every response gets. `?` keeps a header an upstream already set (Keycloak and Mailpit send their own).
	header {
		?Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "no-referrer"
		?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		?Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Liveness of the ingress itself.
	handle /healthz {
		respond "ok" 200
	}

	# API, sign-in callbacks and webhooks. Live updates are server-sent events, so never buffer the response.
	@api path /api/* /auth/* /hooks/*
	handle @api {
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		header Cache-Control "no-store"
		reverse_proxy gantry-api:8000 {
			flush_interval -1
			transport http {
				response_header_timeout 0
				read_timeout 0
			}
		}
	}

	# Identity provider (Keycloak serves under /idp and sets its own CSP and frame headers).
	# Only the gantry realm (sign-in, tokens, account) and the static resources its pages load are public.
	# The admin console, the admin REST API and the master realm are never reachable through the ingress:
	# administrators use the loopback-only port (see deploy/README.md, "Keycloak admin console").
	@idp path /idp/realms/gantry/* /idp/resources/*
	handle @idp {
		reverse_proxy keycloak:8081
	}
	handle /idp/* {
		header Cache-Control "no-store"
		respond "Not found" 404
	}

	# Development-only routes (the Mailpit inbox). GANTRY_INGRESS_PROFILE=prod imports an empty file instead.
	import /etc/caddy/profiles/{$GANTRY_INGRESS_PROFILE:prod}.caddy

	# Everything else is the single-page app.
	handle {
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		header X-Frame-Options "DENY"
		encode zstd gzip
		reverse_proxy gantry-web:8080
	}
}

# The container's healthcheck: plain HTTP on the container's own loopback, so it works whatever the site's name and
# certificate are (busybox wget cannot send the site name as SNI to 127.0.0.1).
http://127.0.0.1:8079 {
	bind 127.0.0.1
	respond /healthz "ok" 200
	respond 404
}

# Keycloak admin console and admin API, for operators only. Compose publishes this listener as 127.0.0.1:8081, so it is
# reachable from the host itself (or through an SSH tunnel), never from the network. KC_HOSTNAME_ADMIN points here.
http://localhost:8081 {
	header -Server
	@admin path /idp/admin/* /idp/realms/master/* /idp/resources/* /idp/js/*
	handle @admin {
		reverse_proxy keycloak:8081
	}
	handle {
		respond "Not found" 404
	}
}
