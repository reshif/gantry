# Production settings for deploy/compose.prod.yml. Copy to deploy/prod.env (ignored by git), fill in, then:
#   docker compose -f deploy/compose.yml -f deploy/compose.prod.yml --env-file deploy/prod.env up -d
# Secrets never go here: they are files in GANTRY_SECRETS_DIR (deploy/secrets/README.md).

# The site. DNS for it must point at this host; ports 443 and 80 must reach it for Let's Encrypt.
GANTRY_HOSTNAME=gantry.example.com
# An email address: a Let's Encrypt certificate. Or your own: GANTRY_TLS=/certs/tls.crt /certs/tls.key (deploy/tls/).
GANTRY_TLS=ops@example.com

# Release images, signed in CI (deploy/verify-images.sh checks them before you start).
GANTRY_IMAGE_PREFIX=ghcr.io/your-org/
GANTRY_VERSION=0.1.0

# The organisation and its first Factory Admin (the first person to sign in with this email).
GANTRY_ORG_ID=acme
GANTRY_ORG_NAME=Acme
GANTRY_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Mail relay, used by Gantry (notifications) and Keycloak (password reset, email verification).
GANTRY_SMTP_HOST=smtp.example.com
GANTRY_SMTP_PORT=587
GANTRY_SMTP_FROM_ADDRESS=gantry@example.com
GANTRY_SMTP_STARTTLS=true
GANTRY_SMTP_SSL=false
# With a login: GANTRY_SMTP_AUTH=true, the user here, the password in the smtp_password secret file.
GANTRY_SMTP_AUTH=false
GANTRY_SMTP_USER=

# Backups: daily at this UTC time, the newest GANTRY_BACKUP_KEEP sets kept, a restore drill weekly (or daily, or off).
GANTRY_BACKUP_AT=02:00
GANTRY_BACKUP_KEEP=7
GANTRY_BACKUP_DRILL=weekly
# Where sets are kept: the `backups` volume, or a host path owned by uid 10001, e.g. /srv/gantry-backups.
GANTRY_BACKUP_VOLUME=backups
# Off-host copy: bucket/prefix on the S3 endpoint in the backup_remote secret file. Empty: no copy.
GANTRY_BACKUP_REMOTE=

# The Docker socket's group on this host: stat -c %g /var/run/docker.sock
DOCKER_GID=999
# Run networks: a private range used by nothing else on this host.
RUN_SUBNET_POOL=10.213.0.0/16
MAX_CONCURRENT_RUNS=32
