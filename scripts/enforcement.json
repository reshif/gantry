{
  "note": "Registry of the checks that enforce the rules in AGENTS.md. scripts/check-agents-rules.mjs verifies every rule names a check here and that every check still exists. kinds: lint-tags (every tag appears in eslint.config.web.js), count-tag (a source-scan tag counted in scripts/lib/frontend-counts.mjs), lint-plugin (a plugin imported in eslint.config.web.js), script (a root package.json script that a workflow runs), file (a file exists and contains the text), review (a line of .github/pull_request_template.md that a reviewer ticks).",
  "checks": {
    "raw-elements": { "kind": "lint-tags", "tags": ["raw-table", "raw-button", "raw-input"] },
    "view-imports": { "kind": "lint-tags", "tags": ["view-import-react-query", "view-import-api-client", "view-import-ops"] },
    "query-keys": { "kind": "lint-tags", "tags": ["literal-query-key"] },
    "read-failures": { "kind": "lint-tags", "tags": ["data-nullish-empty"] },
    "role-literals": { "kind": "lint-tags", "tags": ["role-literal"] },
    "ui-layering": { "kind": "lint-tags", "tags": ["ui-imports-views"] },
    "html-injection": { "kind": "lint-tags", "tags": ["dangerous-html"] },
    "type-escape": { "kind": "lint-tags", "tags": ["as-unknown-as"] },
    "polling": { "kind": "count-tag", "tag": "polling-interval" },
    "a11y-lint": { "kind": "lint-plugin", "plugin": "eslint-plugin-jsx-a11y" },
    "lint-ratchet": { "kind": "script", "script": "lint:ratchet" },
    "dod-report": { "kind": "script", "script": "dod" },
    "bundle-budget": { "kind": "script", "script": "check:bundle" },
    "agents-rules": { "kind": "script", "script": "check:agents" },
    "lint": { "kind": "script", "script": "lint" },
    "typecheck": { "kind": "script", "script": "typecheck" },
    "tests": { "kind": "script", "script": "test" },
    "e2e-ci": { "kind": "file", "path": ".github/workflows/frontend-e2e.yml", "contains": "npm run e2e" },
    "e2e-a11y": { "kind": "file", "path": "apps/web/e2e/a11y.spec.ts", "contains": "AxeBuilder" },
    "e2e-overflow": { "kind": "file", "path": "apps/web/e2e/overflow.spec.ts", "contains": "scrollWidth" },
    "e2e-failure-paths": { "kind": "file", "path": "apps/web/e2e/failure-paths.spec.ts", "contains": "fulfillJson" },
    "e2e-journeys": { "kind": "file", "path": "apps/web/e2e/journeys.spec.ts", "contains": "persona" },
    "e2e-visual": { "kind": "file", "path": "apps/web/e2e/visual.spec.ts", "contains": "toHaveScreenshot" },
    "domain-package": { "kind": "file", "path": "packages/domain/src/package.test.ts", "contains": "sideEffects" },
    "no-router-dependency": { "kind": "file", "path": "scripts/test/gates.test.mjs", "contains": "react-router" },
    "codeowners": { "kind": "file", "path": ".github/CODEOWNERS", "contains": "AGENTS.md" },
    "review-tests-fail-without": { "kind": "review", "item": "fails without the change" },
    "review-agent-led": { "kind": "review", "item": "Agents author and propose" },
    "review-safety-rails": { "kind": "review", "item": "safety rail" },
    "review-agent-copy": { "kind": "review", "item": "agent-voice copy" },
    "review-url-state": { "kind": "review", "item": "in the URL" },
    "review-secrets": { "kind": "review", "item": "No secrets" }
  }
}
