{
  "name": "gantry",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "dod": "node scripts/frontend-dod.mjs",
    "check:agents": "node scripts/check-agents-rules.mjs",
    "check:bundle": "node scripts/bundle-budget.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "yaml": "2.9.1"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
